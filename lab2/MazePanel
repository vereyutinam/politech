package lab2;

import javax.swing.*;
import java.awt.*;

public class MazePanel extends JPanel {

    private final Maze maze;
    private final Mouse mouse;
    private int cellSize = 40;

    public MazePanel(Maze maze, Mouse mouse) {
        this.maze = maze;
        this.mouse = mouse;
        setPreferredSize(new Dimension(
                maze.getWidth() * cellSize,
                maze.getHeight() * cellSize
        ));
        setBackground(new Color(30, 30, 40));
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING,
                RenderingHints.VALUE_ANTIALIAS_ON);

        for (int x = 0; x < maze.getWidth(); x++) {
            for (int y = 0; y < maze.getHeight(); y++) {
                Cell cell = maze.getCell(x, y);
                int px = x * cellSize;
                int py = y * cellSize;

                drawContent(g2, cell, px, py);

                g2.setColor(new Color(120, 80, 200));
                g2.setStroke(new BasicStroke(3));
                if (cell.hasWall(Cell.NORTH))
                    g2.drawLine(px, py, px + cellSize, py);
                if (cell.hasWall(Cell.EAST))
                    g2.drawLine(px + cellSize, py, px + cellSize, py + cellSize);
                if (cell.hasWall(Cell.SOUTH))
                    g2.drawLine(px, py + cellSize, px + cellSize, py + cellSize);
                if (cell.hasWall(Cell.WEST))
                    g2.drawLine(px, py, px, py + cellSize);
            }
        }

        drawMouse(g2);
    }

    private void drawContent(Graphics2D g2, Cell cell, int px, int py) {
        int pad = 8;
        switch (cell.getType()) {
            case CHEESE:
                g2.setColor(new Color(255, 220, 0));
                g2.fillOval(px + pad, py + pad, cellSize - 2 * pad, cellSize - 2 * pad);
                break;
            case WATER:
                g2.setColor(new Color(80, 180, 255));
                g2.fillOval(px + pad, py + pad, cellSize - 2 * pad, cellSize - 2 * pad);
                break;
            case TRAP:
                g2.setColor(new Color(255, 80, 80));
                g2.fillPolygon(
                        new int[]{px + cellSize / 2, px + pad, px + cellSize - pad},
                        new int[]{py + pad, py + cellSize - pad, py + cellSize - pad},
                        3
                );
                break;
            default:
                break;
        }
    }

    private void drawMouse(Graphics2D g2) {
        int px = mouse.getX() * cellSize;
        int py = mouse.getY() * cellSize;
        int pad = 6;

        g2.setColor(new Color(220, 220, 220));
        g2.fillOval(px + pad, py + pad, cellSize - 2 * pad, cellSize - 2 * pad);

        g2.setColor(Color.BLACK);
        g2.fillOval(px + cellSize / 2 - 2, py + cellSize / 2 - 4, 6, 6);
    }
}
