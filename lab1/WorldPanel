package lab1;

import javax.swing.*;
import java.awt.*;

public class WorldPanel extends JPanel {

    private Environment env;
    private int width, height;
    private int cellSize = 16;

    private Font symbolFont;

    // Фоны
    private static final Color BG_PLANT     = new Color(30, 90, 30);     // тёмно-зелёный
    private static final Color BG_HERBIVORE = new Color(220, 220, 220);  // светлый
    private static final Color BG_PREDATOR  = new Color(90, 90, 90);     // серый

    public WorldPanel(Environment env, int width, int height) {
        this.env = env;
        this.width = width;
        this.height = height;

        setPreferredSize(new Dimension(width * cellSize, height * cellSize));
        setBackground(Color.BLACK);

        // Обычный шрифт — символы монохромные
        symbolFont = new Font("SansSerif", Font.BOLD, cellSize - 2);
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);

        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING,
                RenderingHints.VALUE_TEXT_ANTIALIAS_ON);

        // === 1. ФОН ===
        for (int x = 0; x < width; x++) {
            for (int y = 0; y < height; y++) {
                Agent a = env.getAgent(x, y);
                if (a == null) continue;

                Color bg = null;
                if (a instanceof Plant)          bg = BG_PLANT;
                else if (a instanceof Herbivore) bg = BG_HERBIVORE;
                else if (a instanceof Predator)  bg = BG_PREDATOR;

                if (bg != null) {
                    g2.setColor(bg);
                    g2.fillRect(x * cellSize, y * cellSize, cellSize, cellSize);
                }
            }
        }

        // === 2. СИМВОЛЫ (ЧЁРНЫЕ) ===
        g2.setFont(symbolFont);
        g2.setColor(Color.BLACK);            // ← чёрный цвет

        for (int x = 0; x < width; x++) {
            for (int y = 0; y < height; y++) {
                Agent a = env.getAgent(x, y);
                if (a == null) continue;

                String symbol = null;
                if (a instanceof Plant)          symbol = "♣";
                else if (a instanceof Herbivore) symbol = "♥";
                else if (a instanceof Predator)  symbol = "♠";

                if (symbol != null) {
                    g2.drawString(symbol, x * cellSize, y * cellSize + cellSize - 3);
                }
            }
        }

        // === 3. СЕТКА ===
        g2.setColor(new Color(60, 60, 60));
        for (int x = 0; x <= width; x++) {
            int px = x * cellSize;
            g2.drawLine(px, 0, px, height * cellSize);
        }
        for (int y = 0; y <= height; y++) {
            int py = y * cellSize;
            g2.drawLine(0, py, width * cellSize, py);
        }
    }

    public void refresh() {
        repaint();
    }
}
